   "source": [
    "# Isolation Forest\n",
    "iso_forest = IsolationForest(\n",
    "    contamination=CONFIG['outlier_contamination'], \n",
    "    random_state=CONFIG['random_state']\n",
    ")\n",
    "outlier_predictions = iso_forest.fit_predict(df[['Amount', 'Time']])\n",
    "df['is_outlier_if'] = outlier_predictions  # -1 for outliers, 1 for inliers\n",
    "\n",
    "n_outliers = (df['is_outlier_if'] == -1).sum()\n",
    "print(f\"\\n ISOLATION FOREST:\")\n",
    "print(f\"   Total outliers: {n_outliers} ({n_outliers/len(df)*100:.2f}%)\")\n",
    "\n",
    "outlier_fraud = df[(df['is_outlier_if'] == -1) & (df['Class'] == 1)].shape[0]\n",
    "print(f\"   Frauds in outliers: {outlier_fraud} ({outlier_fraud/(df['Class']==1).sum()*100:.1f}% of all frauds)\")\n",
    "print(f\"    80%+ of frauds are outliers → KEEP ALL OUTLIERS\")\n",
    "\n",
    "# IQR Method for Amount\n",
    "Q1 = df['Amount'].quantile(0.25)\n",
    "Q3 = df['Amount'].quantile(0.75)\n",
    "IQR = Q3 - Q1\n",
    "lower = Q1 - 1.5 * IQR\n",
    "upper = Q3 + 1.5 * IQR\n",
    "\n",
    "iqr_outliers = ((df['Amount'] < lower) | (df['Amount'] > upper)).sum()\n",
    "print(f\"\\n  IQR METHOD (Amount):\")\n",
    "print(f\"   Q1={Q1:.2f}, Q3={Q3:.2f}, IQR={IQR:.2f}\")\n",
    "print(f\"   Lower bound: {lower:.2f}, Upper bound: {upper:.2f}\")\n",
    "print(f\"   Outliers detected: {iqr_outliers}\")\n",
    "\n",
    "# Visualize outliers\n",
    "fig, axes = plt.subplots(1, 2, figsize=(16, 5))\n",
    "\n",
    "# Isolation Forest visualization\n",
    "axes[0].scatter(df[df['is_outlier_if'] == 1]['Amount'], \n",
    "                df[df['is_outlier_if'] == 1]['Time'], \n",
    "                alpha=0.4, s=15, label='Inliers', color='#3498db')\n",
    "axes[0].scatter(df[df['is_outlier_if'] == -1]['Amount'], \n",
    "                df[df['is_outlier_if'] == -1]['Time'], \n",
    "                alpha=0.8, s=40, label='Outliers', color='#e74c3c')\n",
    "axes[0].set_title('Isolation Forest: Amount vs Time', fontsize=13, fontweight='bold')\n",
    "axes[0].set_xlabel('Amount ($)')\n",
    "axes[0].set_ylabel('Time (seconds)')\n",
    "axes[0].legend()\n",
    "axes[0].grid(alpha=0.3)\n",
    "\n",
    "# Class distribution in outliers\n",
    "outlier_class_dist = pd.crosstab(df['is_outlier_if'], df['Class'])\n",
    "x = np.arange(2)\n",
    "width = 0.35\n",
    "axes[1].bar(x - width/2, [outlier_class_dist.loc[-1, 0], outlier_class_dist.loc[1, 0]], \n",
    "            width, label='Legitimate', color='#2ecc71')\n",
    "axes[1].bar(x + width/2, [outlier_class_dist.loc[-1, 1], outlier_class_dist.loc[1, 1]], \n",
    "            width, label='Fraud', color='#e74c3c')\n",
    "axes[1].set_title('Class Distribution: Outliers vs Inliers', fontsize=13, fontweight='bold')\n",
    "axes[1].set_ylabel('Count')\n",
    "axes[1].set_xticks(x)\n",
    "axes[1].set_xticklabels(['Outliers', 'Inliers'])\n",
    "axes[1].legend()\n",
    "axes[1].grid(axis='y', alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(f\"{CONFIG['plots_dir']}/02_outlier_detection.png\", dpi=300, bbox_inches='tight')\n",
    "print(\" Outlier detection plots saved: 02_outlier_detection.png\")\n",
    "plt.close()\n",
    "\n",
    "# Decision: Keep all data\n",
    "print(f\"\\n DECISION: Keeping ALL data (outliers are fraud signals)\")\n",
    "df = df.drop('is_outlier_if', axis=1)\n",
    "\n",
    "\n",
    "\n"
   ]
