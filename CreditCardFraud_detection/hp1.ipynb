   "source": [
    "# ============================================================================\n",
    "# SECTION 4: FEATURE ENGINEERING & SCALING\n",
    "# ============================================================================\n",
    "\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"SECTION 4: FEATURE ENGINEERING & SCALING\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "# Separate features and target\n",
    "X = df.drop('Class', axis=1).copy()\n",
    "y = df['Class'].copy()\n",
    "\n",
    "print(f\"\\n📊 Initial features: {X.shape[1]}\")\n",
    "\n",
    "# Time-based Features\n",
    "X['Hour'] = (X['Time'] // 3600) % 24\n",
    "X['Day'] = X['Time'] // (24 * 3600)\n",
    "print(f\"    Time features extracted: Hour, Day\")\n",
    "\n",
    "# Amount transformations\n",
    "X['Amount_log'] = np.log1p(X['Amount'])\n",
    "\n",
    "# Initialize scalers\n",
    "robust_scaler = RobustScaler()\n",
    "standard_scaler = StandardScaler()\n",
    "\n",
    "# Scale Amount (RobustScaler - resistant to outliers)\n",
    "X['Amount_scaled'] = robust_scaler.fit_transform(X[['Amount']])\n",
    "X['Amount_log_scaled'] = robust_scaler.fit_transform(X[['Amount_log']])\n",
    "print(f\"    Amount scaled with RobustScaler (outlier-resistant)\")\n",
    "\n",
    "# Scale Time\n",
    "X['Time_scaled'] = standard_scaler.fit_transform(X[['Time']])\n",
    "print(f\"    Time scaled with StandardScaler\")\n",
    "\n",
    "# Final feature selection\n",
    "feature_columns = (\n",
    "    [col for col in X.columns if col.startswith('V')] +\n",
    "    ['Amount_scaled', 'Amount_log_scaled', 'Time_scaled', 'Hour', 'Day']\n",
    ")\n",
    "\n",
    "X_final = X[feature_columns].copy()\n",
    "\n",
    "print(f\"\\n FINAL FEATURE SET:\")\n",
    "print(f\"   Total features: {len(feature_columns)}\")\n",
    "print(f\"   - PCA features (V1-V28): 28\")\n",
    "print(f\"   - Engineered features: 5\")\n",
    "print(f\"   - Shape: {X_final.shape}\")"
   ]
  },
