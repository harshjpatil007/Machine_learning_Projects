    "ax.set_title('Precision vs Recall (Fraud Detection)', fontsize=13, fontweight='bold')\n",
    "ax.set_ylabel('Score')\n",
    "ax.set_xticks(x)\n",
    "ax.set_xticklabels(models.keys(), rotation=45, ha='right')\n",
