   "source": [
    "# ============================================================================\n",
    "# SECTION 8: COMPREHENSIVE MODEL EVALUATION\n",
    "# ============================================================================\n",
    "\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"SECTION 8: COMPREHENSIVE MODEL EVALUATION\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "def evaluate_model(model, X_test, y_test, model_name):\n",
    "    \"\"\"Comprehensive model evaluation with all metrics\"\"\"\n",
    "    \n",
    "    # Predictions\n",
    "    y_pred = model.predict(X_test)\n",
    "    y_pred_proba = model.predict_proba(X_test)[:, 1]\n",
    "    \n",
    "    # Confusion Matrix\n",
    "    tn, fp, fn, tp = confusion_matrix(y_test, y_pred).ravel()\n",
    "    \n",
    "    # Metrics\n",
    "    accuracy = accuracy_score(y_test, y_pred)\n",
    "    precision = precision_score(y_test, y_pred)\n",
    "    recall = recall_score(y_test, y_pred)\n",
    "    f1 = f1_score(y_test, y_pred)\n",
    "    roc_auc = roc_auc_score(y_test, y_pred_proba)\n",
    "    \n",
    "    # Precision-Recall AUC (best for imbalanced data)\n",
    "    prec_curve, recall_curve, _ = precision_recall_curve(y_test, y_pred_proba)\n",
    "    pr_auc = auc(recall_curve, prec_curve)\n",
    "    \n",
    "    # ROC Curve\n",
    "    fpr, tpr, _ = roc_curve(y_test, y_pred_proba)\n",
    "    \n",
    "    return {\n",
    "        'Model': model_name,\n",
    "        'Accuracy': accuracy,\n",
    "        'Precision': precision,\n",
    "        'Recall': recall,\n",
    "        'F1-Score': f1,\n",
    "        'ROC-AUC': roc_auc,\n",
    "        'PR-AUC': pr_auc,\n",
    "        'TP': tp,\n",
    "        'FP': fp,\n",
    "        'FN': fn,\n",
    "        'TN': tn,\n",
    "        'y_pred': y_pred,\n",
    "        'y_pred_proba': y_pred_proba,\n",
    "        'fpr': fpr,\n",
    "        'tpr': tpr,\n",
    "        'prec_curve': prec_curve,\n",
    "        'recall_curve': recall_curve\n",
    "    }\n",
    "\n",
    "# Evaluate all models\n",
    "results_list = []\n",
    "evaluation_dict = {}\n",
    "\n",
    "for model_name, model in models.items():\n",
    "    print(f\"\\n{'─'*80}\")\n",
    "    print(f\"📊 {model_name.upper()}\")\n",
    "    print(f\"{'─'*80}\")\n",
    "    \n",
    "    result = evaluate_model(model, X_test, y_test, model_name)\n",
    "    evaluation_dict[model_name] = result\n",
    "    results_list.append(result)\n",
    "    \n",
    "    # Print metrics\n",
    "    print(f\"\\n ACCURACY METRICS:\")\n",
    "    print(f\"   Accuracy:    {result['Accuracy']:.4f} ({result['Accuracy']*100:.2f}%)\")\n",
    "    print(f\"   Precision:   {result['Precision']:.4f}\")\n",
    "    print(f\"   Recall:      {result['Recall']:.4f}\")\n",
    "    print(f\"   F1-Score:    {result['F1-Score']:.4f}\")\n",
    "    print(f\"   ROC-AUC:     {result['ROC-AUC']:.4f}\")\n",
    "    print(f\"   PR-AUC:      {result['PR-AUC']:.4f}\")\n",
    "    \n",
    "    # Confusion Matrix\n",
    "    print(f\"\\n CONFUSION MATRIX:\")\n",
    "    print(f\"   TN (Correct Legitimate):  {result['TN']:6d}\")\n",
    "    print(f\"   FP (False Alarm):         {result['FP']:6d}\")\n",
    "    print(f\"   FN (Missed Fraud):        {result['FN']:6d}\")\n",
    "    print(f\"   TP (Caught Fraud):        {result['TP']:6d}\")\n",
    "\n",
    "# Create results DataFrame\n",
    "results_df = pd.DataFrame([\n",
    "    {\n",
    "        'Model': r['Model'],\n",
    "        'Accuracy': f\"{r['Accuracy']:.4f}\",\n",
    "        'Precision': f\"{r['Precision']:.4f}\",\n",
    "        'Recall': f\"{r['Recall']:.4f}\",\n",
    "        'F1-Score': f\"{r['F1-Score']:.4f}\",\n",
    "        'ROC-AUC': f\"{r['ROC-AUC']:.4f}\",\n",
    "        'PR-AUC': f\"{r['PR-AUC']:.4f}\"\n",
    "    }\n",
    "    for r in results_list\n",
    "])\n",
    "\n",
    "print(f\"\\n{'='*80}\")\n",
    "print(f\" MODEL COMPARISON TABLE\")\n",
    "print(f\"{'='*80}\\n\")\n",
    "print(results_df.to_string(index=False))\n",
    "\n",
    "# Save results\n",
    "results_df.to_csv(f\"{CONFIG['results_dir']}/model_comparison.csv\", index=False)\n",
    "print(f\"\\n Results saved: model_comparison.csv\")\n",
    "\n",
    "\n"
   ]
